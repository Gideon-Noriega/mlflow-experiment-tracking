# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=customer-churn

# Artifact Store (MinIO / S3)
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=mlflow
AWS_SECRET_ACCESS_KEY=mlflow123
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts

# Backend Store (PostgreSQL)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow123
POSTGRES_DB=mlflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Model Serving
MODEL_NAME=customer-churn-model
SERVING_PORT=8080
AB_CHAMPION_WEIGHT=0.9
AB_CHALLENGER_WEIGHT=0.1

# Tuning
OPTUNA_N_TRIALS=50
OPTUNA_STUDY_NAME=churn-hpo
